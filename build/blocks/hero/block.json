{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hawthorn/hero",
  "version": "1.0.0",
  "title": "Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "A centred page hero with flexible supporting content.",
  "keywords": [
    "hero",
    "banner",
    "heading"
  ],
  "textdomain": "hawthorn",
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "variant": {
      "type": "string",
      "default": "standard"
    }
  },
  "supports": {
    "align": [
      "full"
    ],
    "anchor": true,
    "color": false,
    "customClassName": false,
    "html": false,
    "spacing": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}